<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>

    <httpPlatform processPath="C:\inetpub\wwwroot\AutoProdPlanner\.venv\Scripts\python.exe"
                  arguments="-m uvicorn src.api.app:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\python.log"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="ENVIRONMENT" value="Production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>